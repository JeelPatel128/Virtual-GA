# Copy to .env for local runs. On Render, set these as Environment Variables instead.

# The public URL of the app (Render gives you this). Used for the QR code and Teams links.
PUBLIC_BASE_URL=http://localhost:8000

# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_PASSWORD=
GA_KEY=
CRON_SECRET=

# Supabase > Project Settings > Database > Connection string (Session pooler URI). Leave empty for local SQLite.
DATABASE_URL=

# Google AI Studio > Get API key
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Teams > channel > Workflows > "Post to a channel when a webhook request is received" > copy URL
TEAMS_WEBHOOK_URL=
LEAD_ALERT_ON_EVERY_HANDOFF=true

# Google Calendar > Settings > (your GA calendar) > Integrate calendar > "Secret address in iCal format"
GCAL_ICS_URL=

TIMEZONE=America/New_York
ESCALATE_AFTER_MINUTES=5
REMINDER_STEP_MINUTES=15
DIGEST_HOUR=17
PHONE_RETENTION_DAYS=30
FRONT_DESK_LOCATION=the School of Business front desk

# Optional: put the contents of team.json here instead of committing the file
TEAM_JSON=

# Optional: Supabase Storage for task-request file attachments (private bucket "task-files").
# If unset, falls back to a local DB table - see app/storage.py.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TASK_FILE_MAX_MB=10

# Optional: emails the requester a link to confirm a task was taken care of.
# Skipped quietly if SMTP_HOST is unset - see app/tickets.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
